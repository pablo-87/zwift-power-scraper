# Database Configuration
DB_NAME=zwift_racing
DB_USER=zwift_user
DB_PASS=changeme_secure_password
DB_HOST=postgres  # Use 'postgres' for Docker, 'localhost' for local development
DB_PORT=5432

# ZwiftPower Authentication Cookies
# These cookies are obtained from your browser after logging into ZwiftPower
# They will be automatically refreshed by the cookie_refresher.py script
PHPBB3_SID=your_phpbb_session_id_here
PHPBB3_U=your_phpbb_user_id_here
CLOUDFRONT_KEY_PAIR_ID=your_cloudfront_key_pair_id_here
CLOUDFRONT_POLICY=your_cloudfront_policy_here
CLOUDFRONT_SIGNATURE=your_cloudfront_signature_here

# Zwift Account Credentials (for automatic cookie refresh)
ZWIFT_USER=your_zwift_email@example.com
ZWIFT_PASS=your_zwift_password_here

# Optional: pgAdmin Configuration (for database management UI)
PGADMIN_EMAIL=admin@zwift.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
